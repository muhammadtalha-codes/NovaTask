// Prisma schema for NovaTask - AI-powered 3D personal task manager

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  password      String?
  image         String?
  preferences   String         @default("{}") // JSON: theme, timeFormat, dateFormat, notifications, aiPrefs
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  accounts      Account[]
  sessions      Session[]
  tasks         Task[]
  reminders     Reminder[]
  chatMessages  ChatMessage[]
  plans         Plan[]
  notifications Notification[]
}

// NextAuth models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
}

model Task {
  id             String   @id @default(cuid())
  userId         String
  title          String
  description    String?
  subject        String?
  // type: ASSIGNMENT | QUIZ | EXAM | MEETING | PROJECT | STUDY | PERSONAL | OTHER
  type           String   @default("OTHER")
  date           DateTime?
  time           String?
  deadline       DateTime?
  // priority: HIGH | MEDIUM | LOW
  priority       String   @default("MEDIUM")
  // status: PENDING | IN_PROGRESS | COMPLETED
  status         String   @default("PENDING")
  reminderEnabled Boolean  @default(false)
  reminderTime   DateTime?
  // recurring: JSON string -> { type: NONE|DAILY|WEEKLY|MONTHLY, until?: ISO }
  recurring      String   @default("{\"type\":\"NONE\"}")
  notes          String?
  order          Int      @default(0)
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminders       Reminder[]
  subtasks        Subtask[]

  @@index([userId, status])
  @@index([userId, date])
  @@index([userId, priority])
}

model Subtask {
  id        String   @id @default(cuid())
  taskId    String
  title     String
  done      Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  // kind: reminder | deadline | system | ai | info
  kind      String   @default("info")
  title     String
  message   String?
  // link: optional view key or task id to navigate to
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}

model Reminder {
  id            String    @id @default(cuid())
  userId        String
  taskId        String?
  title         String
  message       String?
  time          DateTime
  // status: PENDING | SNOOZED | COMPLETED | DISMISSED
  status        String    @default("PENDING")
  snoozedUntil  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  task          Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([userId, time])
}

model ChatMessage {
  id          String   @id @default(cuid())
  userId      String
  // role: user | assistant
  role        String
  content     String
  // actionData: JSON string of structured AI action + result
  actionData  String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Plan {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  // content: JSON string of generated schedule blocks
  content   String
  summary   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}
